{
  "name": "moh-bcp",
  "version": "2.3.8",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve",
    "start": "npm run dev",
    "dev": "ng serve --port=4201 --host=0.0.0.0 -o",
    "prebuild": "node src/version.js",
    "build": "ng build --prod",
    "test": "ng test",
    "test-ci": "ng test --karma-config=src/karma.ci.conf.js",
    "test:coverage": "echo \"WARNING: No test specified\" && exit 0",
    "test:lint": "echo \"WARNING: No LINTer specified\" && exit 0",
    "test:schema": "echo \"WARNING: No schema specified\" && exit 0",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e-protractor": "npx protractor",
    "e2e:bcppa": "npm run e2e -- --protractorConfig=e2e/practitioner-assignment/protractor-bcp-pa.conf.js --port=4300",
    "e2e:bcppa-happy-path": "npm run e2e -- --protractorConfig=e2e/practitioner-assignment/protractor-bcp-pa-happy-path.conf.js --port=4300",
    "e2e:bcprf": "npm run e2e -- --protractorConfig=e2e/register-facility/protractor-bcp-rf.conf.js --port=4300",
    "e2e:bcprf-happy-path": "npm run e2e -- --protractorConfig=e2e/register-facility/protractor-bcp-rf-happy-path.conf.js --port=4300",
    "e2e:bcp": "npm run e2e-protractor -- e2e/register-facility/protractor.bcp.conf.js",
    "chrome-update": "sudo apt-get install google-chrome-stable",
    "webdriver-update": "webdriver-manager update"
  },
  "private": true,
  "dependencies": {
    "@angular-devkit/build-angular": "~19.2.25",
    "@angular/animations": "~19.2.25",
    "@angular/common": "~19.2.25",
    "@angular/compiler": "~19.2.25",
    "@angular/core": "~19.2.25",
    "@angular/forms": "~19.2.25",
    "@angular/platform-browser": "~19.2.25",
    "@angular/platform-browser-dynamic": "~19.2.25",
    "@angular/router": "~19.2.25",
    "@ng-select/ng-select": "^14.0.0",
    "angular2-text-mask": "^9.0.0",
    "angular2-uuid": "^1.1.1",
    "blueimp-load-image": "^5.16.0",
    "bootstrap": "^5.3.8",
    "core-js": "^3.50.0",
    "date-fns": "^4.4.0",
    "font-awesome": "^4.7.0",
    "moh-common-lib-angular": "^2.4.0",
    "moment": "^2.31.0",
    "mygovbc-bootstrap-theme": "^0.4.1",
    "ngx-bootstrap": "^19.0.2",
    "ngx-mydatepicker": "^2.4.11",
    "pdfjs-dist": "^4.10.38",
    "puppeteer": "^25.11.0",
    "rxjs": "7.8.2",
    "sha1": "^1.1.1",
    "signature_pad": "^5.1.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/cli": "~19.2.25",
